<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head') %>
<body>
    <%- include('../partials/header') %>
    <main class="main">
        <header class="page-header">
            <h1 class="page-title">Edit <%= category.name %></h1>
        </header>

        <form action="/categories/<%= category.id %>/edit" method="post" class="form">
            <div class="form__group">
                <label for="name" class="form__label">Name</label>
                <input type="text" name="name" id="name" class="form__input" value="<%= category.name %>" required>
            </div>
            <div class="form__group">
                <label for="description" class="form__label">Description</label>
                <textarea name="description" id="description" class="form__textarea"><%= category.description %></textarea>
            </div>
            <div class="card__actions">
                <a href="/categories/<%= category.id %>" class="btn btn--secondary">Cancel</a>
                <button type="submit" class="btn btn--primary">Update</button>
            </div>
        </form>
    </main>
</body>
</html>

