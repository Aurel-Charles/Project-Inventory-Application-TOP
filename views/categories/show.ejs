<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head') %>
<body>
    <%- include('../partials/header') %>
    <main class="main">
        <header class="page-header">
            <h1 class="page-title"><%= category.name %></h1>
            <div class="card__actions">
                <a href="/categories/<%= category.id %>/edit" class="btn btn--secondary">Edit</a>
                    <button data-action="/categories/<%= category.id %>/delete" class="btn btn--danger required-password">X</button>
            </div>
        </header>

        <% if(items.length === 0){ %>
            <p class="empty-state">No items in this category yet.</p>
        <% } else { 
            items.forEach(item => { %>
                <article class="card">
                    <div class="card__body">
                        <a href="/items/<%= item.id %>" class="card__title"><%= item.name %></a>
                    </div>
                </article>
        <% }) } %>
    </main>
</body>
</html>