<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head') %>
<body>
    <%- include('../partials/header') %>
    <main class="main">
        <header class="page-header">
            <h1 class="page-title">Categories</h1>
            <a href="/categories/new" class="btn btn--primary">+ Add</a>
        </header>

        <% if(categories.length === 0){ %>
            <p class="empty-state">No categories yet.</p>
        <% } else { 
            categories.forEach(category => { %>
                <article class="card">
                    <div class="card__body">
                        <p class="card__title"><%= category.name %></p>
                        <p class="card__description"><%= category.description %></p>
                    </div>
                    <div class="card__actions">
                        <a href="/categories/<%= category.id %>" class="btn btn--secondary">Details</a>
                        <a href="/categories/<%= category.id %>/edit" class="btn btn--secondary">Edit</a>
                        <button data-action="/categories/<%= category.id %>/delete" class="btn btn--danger required-password">X</button>
                    </div>
                </article>
        <% }) } %>
    </main>
</body>
</html>

