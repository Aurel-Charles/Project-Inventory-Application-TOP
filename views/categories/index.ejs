<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head') %>
<body>
    <p>Category index</p>
    <% if(categories.length === 0){ %>
        <p>there's no categories</p>
    <% } else { 
        categories.forEach(category => { %>
            <a href="/categories/<%= category.id %>">
                <%= category.name %>
            </a>
    <% }) } %>                                           
</body>
</html>

