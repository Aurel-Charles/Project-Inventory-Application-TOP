<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head') %>
<body>
    <h1>Torrefactors index</h1>
    <a href="/torrefactors/new">Add a torrefactor</a>
    <br>
    <% if(torrefactors.length === 0){ %>
        <p>there's no torrefactors</p>
    <% } else { 
        torrefactors.forEach(torrefactor => { %>
            <a href="/torrefactors/<%= torrefactor.id %>"> <%= torrefactor.name %> </a>
            <p> <%= torrefactor.country %> </p>
            <a href="<%= torrefactor.website %>" target="_blank">Website</a>
            <form action="torrefactors/<%= torrefactor.id %>/delete" method="post">
                <button type="submit">X</button>
            </form>
            <a href="/torrefactors/<%= torrefactor.id %>/edit">Edit</a>
    <% }) } %>                                           
</body>
</html>

