<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head') %>
<body>
    <%- include('../partials/header') %>
    <main class="main">
        <header class="page-header">
            <h1 class="page-title">Torrefactors</h1>
            <a href="/torrefactors/new" class="btn btn--primary">+ Add</a>
        </header>

        <% if(torrefactors.length === 0){ %>
            <p class="empty-state">No torrefactors yet.</p>
        <% } else { 
            torrefactors.forEach(torrefactor => { %>
                <article class="card">
                    <div class="card__body">
                        <p class="card__title"><%= torrefactor.name %></p>
                        <p class="card__description"><%= torrefactor.country %></p>
                    </div>
                    <div class="card__actions">
                        <a href="<%= torrefactor.website %>" target="_blank" class="btn btn--secondary">Website</a>
                        <a href="/torrefactors/<%= torrefactor.id %>" class="btn btn--secondary">Details</a>
                        <a href="/torrefactors/<%= torrefactor.id %>/edit" class="btn btn--secondary">Edit</a>
                        <button data-action="/torrefactors/<%= torrefactor.id %>/delete" class="btn btn--danger required-password">X</button>
                    </div>
                </article>
        <% }) } %>
    </main>
</body>
</html>

