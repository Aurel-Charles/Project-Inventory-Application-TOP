<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head') %>
<body>
    <h1> <%= torrefactor.name %> </h1>
    <% if(items.length === 0){%> <p>there's no items</p> <% }
    else{
        items.forEach(item => { %>
            <a href="/items/<%= item.id %>">
                <%= item.name %>
            </a>
        <% }) }%>                                                
</body>
</html>