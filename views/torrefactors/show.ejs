<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head') %>
<body>
    <%- include('../partials/header') %>
    <h1> <%= torrefactor.name %> </h1>
    <form action="/torrefactors/<%= torrefactor.id %>/delete" method="post">
        <button type="submit">X</button>
    </form>
    <a href="/torrefactors/<%= torrefactor.id %>/edit">Edit</a>
    <% if(items.length === 0){%> 
        <p>there's no items</p> 
    <% }
    else{
        items.forEach(item => { %>
            <a href="/items/<%= item.id %>">
                <%= item.name %>
            </a>
        <% }) }%>                                                
</body>
</html>