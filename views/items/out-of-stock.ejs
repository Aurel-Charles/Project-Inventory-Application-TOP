<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head') %>
<body>
    <%- include('../partials/header') %>
    <main class="main">
        <header class="page-header">
            <h1 class="page-title">Items OUT OF STOCK</h1>
        </header>

        <% if(items.length === 0){ %>
            <p class="empty-state">No items yet.</p>
        <% } else { items.forEach(item => { %>
            <article class="card">
                <div class="card__body">
                    <p class="card__title"><%= item.name %></p>
                    <p class="card__description">
                        <%= item.category_name %>
                        <% if(item.torrefactor_name){ %> — <%= item.torrefactor_name %><% } %>
                    </p>
                </div>
                <div class="card__actions">
                    <a href="/items/<%= items.id %>" class="btn btn--secondary">Details</a>
                    <a href="/items/<%= item.id %>/edit" class="btn btn--secondary">Edit</a>
                    <form action="/items/<%= item.id %>/delete" method="post">
                        <button type="submit" class="btn btn--danger">X</button>
                    </form>
                </div>
            </article>
        <% }) } %>
    </main>
</body>
</html>
