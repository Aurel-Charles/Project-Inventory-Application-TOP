<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head') %>
<body>
    <%- include('../partials/header') %>
    <main class="main">
        <header class="page-header">
            <h1 class="page-title"><%= item.name %></h1>
            <div class="card__actions">
                <a href="/items/<%= item.id %>/edit" class="btn btn--secondary">Edit</a>
                <form action="/items/<%= item.id %>/delete" method="post">
                    <button type="submit" class="btn btn--danger">X</button>
                </form>
            </div>
        </header>

        <article class="item-detail">
            <p class="item-detail__description"><%= item.description %></p>
            <dl class="item-detail__meta">
                <dt>Prix</dt>
                <dd><%= item.price %> €</dd>
                <dt>Stock</dt>
                <dd><%= item.quantity %></dd>
                <dt>Catégorie</dt>
                <dd><a href="/categories/<%= category.id %>"><%= category.name %></a></dd>
                <dt>Torréfacteur</dt>
                <dd>
                    <% if(torrefactor) { %>
                        <a href="/torrefactors/<%= torrefactor.id %>"><%= torrefactor.name %></a>
                    <% } else { %>
                        -
                    <% } %>
                </dd>
            </dl>
        </article>
    </main>
</body>
</html>